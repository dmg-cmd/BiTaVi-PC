# Dependencias
node_modules/
package-lock.json.bak

# Compilación y paquetes de distribución
dist/
target/
src-tauri/target/

# Permitir paquetes de distribución y ejecutables oficiales en release/
!release/
!release/**

# Logs y entornos
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# Archivos del sistema e IDE
.DS_Store
Thumbs.db
desktop.ini
.~lock.*
*.tmp
.vscode/
.idea/

# ========================================================
# EXCLUSIÓN ESTRICTA DE BACKUPS PERSONALES / DE CELULAR
# ========================================================
# Ignorar cualquier archivo comprimido o backup en cualquier carpeta
*.zip
*.tar
*.tar.gz
*.7z
*.rar
backup_*
backup*

# Excepciones ÚNICAS: Paquetes oficiales en release/ y datos de prueba
!release/
!release/*
!release/**/*
!sample-data/
sample-data/*
!sample-data/backup_ejemplo_bitavi.zip
!sample-data/recorrido_tactico_ejemplo.gpx
